; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="WASM Doom: Godot Edition"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.008, 0.006, 1)

[audio]

driver/enable_input=false
